# Copy this file to `.env` in the backend directory and adjust as needed.
# All values below are the local-development defaults already used if
# these variables are unset, so `.env` is optional for local dev.

# Path to the KSL model file (relative paths resolve from the backend/ directory).
KSL_MODEL_PATH=ksl-model-source/best_model.h5

# Minimum confidence (0.0-1.0) required for a prediction to be "accepted".
KSL_CONFIDENCE_THRESHOLD=0.70

# Comma-separated list of allowed CORS origins.
# Add your deployed Vercel frontend URL here later, e.g.:
# CORS_ORIGINS=http://localhost:5174,https://fadhili-ai.vercel.app
CORS_ORIGINS=http://localhost:5174